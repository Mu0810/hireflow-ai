# ===========================================================================
# Jarvis configuration. Copy to `.env` and fill in. All secrets live here.
# Only OPENROUTER_API_KEY is required to start chatting.
# Every variable is prefixed JARVIS_ except third-party tokens.
# ===========================================================================

# --- LLM (OpenRouter + Kimchi) --------------------------------------------
OPENROUTER_API_KEY=
KIMCHI_API_KEY=
# Provider selection: "openrouter" or "kimchi"
JARVIS_LLM_PROVIDER=openrouter
# Default model used for chat + tool calling. Works for both providers.
JARVIS_LLM_MODEL=anthropic/claude-3.5-sonnet
# Optional: model used for fast/cheap auxiliary calls (summaries, titles).
JARVIS_LLM_FAST_MODEL=anthropic/claude-3.5-haiku
JARVIS_LLM_TEMPERATURE=0.7
JARVIS_LLM_MAX_TOKENS=2048
# Sent to OpenRouter for attribution (optional).
JARVIS_OPENROUTER_REFERRER=http://localhost:8000
JARVIS_OPENROUTER_TITLE=Jarvis
# Kimchi API endpoint (only used when JARVIS_LLM_PROVIDER=kimchi)
JARVIS_KIMCHI_BASE_URL=https://llm.kimchi.dev/openai/v1

# --- Identity / persona ---------------------------------------------------
JARVIS_ASSISTANT_NAME=Jarvis
JARVIS_USER_NAME=
# Free-form persona/system-prompt addendum.
JARVIS_PERSONA=You are Jarvis, a concise, capable personal assistant.

# --- Server ---------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
# Bearer token required by the dashboard API (leave blank to disable auth — local only!).
JARVIS_DASHBOARD_TOKEN=

# --- Storage --------------------------------------------------------------
# Paths are relative to the data dir unless absolute.
JARVIS_DATA_DIR=./data
JARVIS_SQLITE_PATH=./data/jarvis.db
JARVIS_CHROMA_DIR=./data/chroma
JARVIS_AUDIT_DIR=./data/audit

# --- Memory ---------------------------------------------------------------
# How many recent messages to include verbatim in context.
JARVIS_MEMORY_RECENT_TURNS=12
# How many semantic matches to retrieve.
JARVIS_MEMORY_SEMANTIC_K=6
# Force the lightweight difflib semantic store instead of ChromaDB
# (skips downloading an embedding model; useful for minimal installs).
JARVIS_VECTOR_FALLBACK=false

# --- Security -------------------------------------------------------------
# Capabilities granted by default. Comma-separated. See docs/SECURITY.md.
#   fs.read, fs.write, shell.exec, app.open, browser, network
JARVIS_ALLOWED_CAPABILITIES=fs.read,app.open,browser
# Directory the agent is jailed to for file ops (relative paths resolve here).
JARVIS_WORKSPACE_DIR=./workspace
# Shell commands the sandbox may run (comma-separated allowlist). Empty = none.
JARVIS_SHELL_ALLOWLIST=ls,cat,echo,pwd,date,whoami,uname,df,du,git
# Seconds before a sandboxed subprocess is killed.
JARVIS_SHELL_TIMEOUT=20
# Require confirmation before dangerous actions (fs.write, shell.exec).
JARVIS_REQUIRE_CONFIRMATION=true

# --- Channels: Telegram (reference implementation) ------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the bot (empty = allow all).
JARVIS_TELEGRAM_ALLOWED_USERS=

# --- Channels: Discord / Slack (stubs) ------------------------------------
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Voice (opt-in; `pip install -e ".[voice]"`) --------------------------
JARVIS_VOICE_WAKE_WORD=jarvis
JARVIS_VOICE_STT_MODEL=base.en
# Optional Piper model. If missing, macOS `say` (or espeak) is used instead.
JARVIS_VOICE_PIPER_MODEL=./data/models/en_US-lessac-medium.onnx
JARVIS_VOICE_INPUT_DEVICE=
JARVIS_VOICE_OUTPUT_DEVICE=
# Energy gate (RMS 0..1) for detecting that you're speaking. Auto-calibrated up
# to the ambient noise floor at startup.
JARVIS_VOICE_SPEECH_THRESHOLD=0.02
# Barge-in: stop talking the moment you start speaking again.
JARVIS_VOICE_BARGE_IN=true
# Barge-in sensitivity (RMS). Raise if it self-interrupts on open speakers;
# lower if it doesn't notice you. Works best with headphones (no echo).
JARVIS_VOICE_BARGE_IN_THRESHOLD=0.05
# Say "Yes?" when the wake word fires.
JARVIS_VOICE_ACKNOWLEDGE=true
# Seconds to keep listening for a follow-up before re-arming the wake word.
JARVIS_VOICE_FOLLOWUP_TIMEOUT=8.0
# Start the voice loop automatically inside the dashboard process (`serve`).
# Equivalent to `serve --voice`. The dashboard can also toggle it at runtime.
JARVIS_VOICE_AUTOSTART=false

# --- MCP ------------------------------------------------------------------
# JSON array of MCP servers to connect on startup. Example:
# JARVIS_MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
JARVIS_MCP_SERVERS=[]

# --- Plugins --------------------------------------------------------------
# Extra directory scanned for user plugins (built-in examples always load).
JARVIS_PLUGINS_DIR=./plugins

# --- Logging --------------------------------------------------------------
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_JSON=false
